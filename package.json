{
  "name": "stayscape",
  "version": "1.0.0",
  "private": true,
  "description": "StayScape: a MERN accommodation booking platform (MongoDB, Express, React, Node.js).",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch backend/server.js\" \"vite frontend\"",
    "build": "vite build frontend",
    "start": "node backend/server.js",
    "seed": "node backend/scripts/seed.js",
    "lint": "eslint .",
    "test": "node --test \"backend/tests/**/*.test.js\"",
    "check": "npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Sachin Kumar",
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "bootstrap": "^5.3.8",
    "cloudinary": "^2.11.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "flatpickr": "^4.6.13",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "leaflet": "^1.9.4",
    "mongoose": "^9.9.1",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^9.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "supertest": "^7.3.0",
    "vite": "^8.3.1"
  }
}
